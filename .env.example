# ContextIQ — Environment Variables
# Copy to .env and fill in your values

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-west-2
AWS_PROFILE=your-aws-profile
AWS_ACCOUNT_ID=your-12-digit-account-id

# ── Memory: GraphRAG KB + Neptune Analytics ───────────────────────────────────
# Required for agent runtime
GRAPHRAG_KB_ID=your-graphrag-kb-id
NEPTUNE_GRAPH_ID=your-neptune-graph-id

# Required for ingestion scripts (context_engine/ tools only)
GRAPHRAG_DS_ID=your-graphrag-datasource-id
BEE_CONTEXT_BUCKET=bee-context-store-<account-id>-<region>

# ── Bee Account ───────────────────────────────────────────────────────────────
# Your Bee account id — used as the `beeAccountId` metadata filter on KB
# retrieval and as the default --user-id for ingestion scripts
BEE_ACCOUNT_ID=your-bee-account-id

# ── APIs ──────────────────────────────────────────────────────────────────────
# OpenWeatherMap — https://openweathermap.org/api (free tier)
OPENWEATHERMAP_API_KEY=your-key-here

# Tavily — https://tavily.com (web search)
TAVILY_API_KEY=your-key-here

# Todoist — https://todoist.com/app/settings/integrations/developer (reminders)
TODOIST_API_TOKEN=your-token-here

# Yelp Fusion — https://www.yelp.com/developers/v3/manage_app (restaurant search)
YELP_API_KEY=your-key-here

# ── Demo / Development ────────────────────────────────────────────────────────
# Set to true to mock weather without a valid API key
# Mock returns: rain on current date, clear on next two days
WEATHER_MOCK=false
